from time import time
begin = time()
i = 2
while i < 100000:
    flag = True
    j = 2
    while j < i ** 0.5:
        if i % j == 0:
            flag = False
            break
        j += 1
    if flag:
        # pass
        print(i, '是质数')
    i += 1
end = time()
print('程序花费了:',end - begin,'秒~')
